<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Require_Resolution_Notes</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Status__c, &quot;Resolved&quot;),
        ISPICKVAL(Status__c, &quot;Closed&quot;)
    ),
    ISBLANK(Resolution_Notes__c)
)</errorConditionFormula>
    <errorDisplayField>Resolution_Notes__c</errorDisplayField>
    <errorMessage>Please provide detailed Resolution Notes explaining how the issue was resolved.</errorMessage>
</ValidationRule>
